# 复制为 .env 后填写（.env 已被 gitignore，永远不进仓库）

# ---- LLM：开发期可用 GLM 免费额度，正式跑批切 DeepSeek ----
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-flash
# 单次调用 read 超时（秒）；默认 120 覆盖长思考生成
LLM_TIMEOUT_S=120
# planner/writer 用的强模型（模型分级；留空回落到 LLM_MODEL）
STRONG_LLM_MODEL=
# 思考模式：v4-flash 默认开启，这里默认关掉——
# ① 思考+tools 多轮必须回传 reasoning_content 否则 400（代码已支持回传）
# ② 思考 token 按输出计费；③ 思考模式下 temperature 静默失效
# 可选：enabled / disabled / auto（auto=用服务端默认，不干预）
LLM_THINKING=disabled

# ---- 评测 judge：必须与被评系统不同厂商（防同源偏差，见 schemas.py）----
# 注意：judge 想要 temperature=0 时必须同时关思考，否则该参数静默不生效
JUDGE_API_KEY=
JUDGE_BASE_URL=
JUDGE_MODEL=
# judge 思考档位（GLM-5.3 强制思考）：low 会忽略 rubric 边界规则，high 校准一致率更高
JUDGE_THINKING=high

# ---- 搜索：Tavily 免费层 1000 次/月，配额过半切 SearXNG ----
TAVILY_API_KEY=

# ---- 本地路径 ----
DATABASE_PATH=data/agent.db
TRACE_DIR=data/traces
PAGES_DIR=data/pages
